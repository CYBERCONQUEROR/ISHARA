FROM python:3.10-slim

WORKDIR /app/backend

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY backend/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code & model files (IMPORTANT: no extra folder!)
COPY backend/ /app/backend/

# Debug: list to verify files exist
RUN echo "=== BACKEND FILES INSIDE CONTAINER ===" && ls -l /app/backend

EXPOSE 8001

HEALTHCHECK CMD curl -f http://localhost:${PORT:-8001}/ || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "${PORT:-8001}"]
