FROM python:3.10-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements
COPY backend/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code & models
COPY backend/ ./backend/

# Copy model files into backend folder
COPY backend/linux.h5 backend/linux.h5
COPY backend/krishnav.pkl backend/krishnav.pkl



EXPOSE 8001

HEALTHCHECK CMD curl -f http://localhost:${PORT:-8001}/ || exit 1

CMD uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8001}
