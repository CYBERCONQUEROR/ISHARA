# Frontend build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Accept env variable during build
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Copy package files
COPY package*.json ./
RUN npm install

# Copy rest of the frontend source (src/, public/, vite config, etc.)
COPY . .

# Build Vite frontend
RUN npm run build

# Serve with nginx
FROM nginx:alpine

# Copy built frontend
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy minimal nginx config
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
